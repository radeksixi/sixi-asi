MODELS = os.path.join(SPEECH, "models")
VENV_PY = os.path.join(SPEECH, "venv", "bin", "python")
LOG = os.path.join(SPEECH, "service.log")
UNIT = "sixi-speech.service"
UNIT_PATH = os.path.expanduser(os.path.join("~/.config/systemd/user", UNIT))
RELEASES = "https://github.com/k2-fsa/sherpa-onnx/releases/download/"
STT_DIR = "sherpa-onnx-whisper-turbo"                         # multilingual fallback (Chinese, Japanese, ...)
PARAKEET_DIR = "sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"   # NVIDIA Parakeet TDT 0.6b v3: 25 European languages, fast on a CPU
PARAKEET_URL = "https://huggingface.co/csukuangfj/" + PARAKEET_DIR + "/resolve/main/"
PARAKEET_FILES = ["encoder.int8.onnx", "decoder.int8.onnx", "joiner.int8.onnx", "tokens.txt"]
PARAKEET_LANGS = {"bg", "hr", "cs", "da", "nl", "en", "et", "fi", "fr", "de", "el", "hu", "it", "lv", "lt", "mt", "pl", "pt", "ro", "sk",
                  "sl", "es", "sv", "ru", "uk"}
VOICES = {   # name -> voice folder (Piper voices packaged for sherpa-onnx)
    "pl": "vits-piper-pl_PL-darkman-medium",
    "pl-female": "vits-piper-pl_PL-zenski_wg_glos-medium",
    "en": "vits-piper-en_US-lessac-medium",
    "de": "vits-piper-de_DE-thorsten-medium",
    "fr": "vits-piper-fr_FR-siwis-medium",
    "it": "vits-piper-it_IT-paola-medium",
}
# A phrase in the language, spoken by the service's own voice and put in front of a short clip before Parakeet
# hears it. Parakeet has no input for the language: it decides from the audio, and takes a one-syllable word in
# another language for English (a Polish "nie" comes back as "Yeah."). With the phrase in front it stays in the
# language; the phrase is taken off the text again. English needs none.
# The join can cost the clip its first sound ("Stop." after the phrase comes back as "Top."). So the clip is heard
# a second time with another phrase behind it, where its start is the start of the audio; when the two texts end
# alike and begin differently, the beginning is taken from that second one.
LEAD_IN = {     # language -> (phrase in front, phrase behind, voices to say them with: the first installed one)
    "pl": ("Odpowiedź brzmi:", "Tak brzmi moja odpowiedź.", ("pl-female", "pl")),
    "de": ("Die Antwort lautet:", "So lautet meine Antwort.", ("de",)),
    "it": ("La risposta è:", "Questa è la mia risposta.", ("it",)),
    "fr": ("La réponse est :", "C'est ma réponse.", ("fr",)),
}
